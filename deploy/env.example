# PostgreSQL pripojenie
DATABASE_URL=postgres://lifeos:lifeos_prod_pw@localhost:5432/lifeos?sslmode=disable

# JWT podpisovací kľúč — zmeň na dlhý náhodný reťazec!
# Vygeneruj: openssl rand -hex 32
JWT_SECRET=zmen_na_nahodny_retazec

# Port backendu (voliteľné, default: 8083)
# PORT=8083

# CORS — nastav na doménu/IP servera ak chceš obmedziť
# CORS_ORIGIN=http://1.2.3.4
